# Relic configuration. Copy to .env and start with `./relic --env .env`.
# .env is private and ignored by Git. See docs/CONFIGURATION.md.

# Server and storage. Relative paths resolve from this file.
RELIC_NAME='Relic'
RELIC_HOST='127.0.0.1'
RELIC_PORT='8790'
RELIC_DATA_DIR='./data'
RELIC_STATE_DIR='./state'
RELIC_SESSION_DIR='./private/sessions'
RELIC_AUTO_PRUNE='false'

# Telegram (https://my.telegram.org). You log in once from the Sources view.
TELEGRAM_API_ID=''
TELEGRAM_API_HASH=''
TELEGRAM_SESSION='relic'

# Ships: a KeelWatch AIS history service.
KEELWATCH_URL=''
KEELWATCH_TOKEN=''
KEELWATCH_FRESHNESS='24h'
KEELWATCH_INCLUDE_ANONYMOUS='false'
KEELWATCH_TIMEOUT_SECONDS='15'

# Optional AI through OpenRouter: message reading, event grouping, ship finder.
OPENROUTER_API_KEY=''
OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
AI_DEFAULT_MODEL='openai/gpt-6-luna'
AI_EMBEDDING_MODEL='openai/text-embedding-3-small'

